# === Supabase (base de datos, auth, storage) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO en el servidor (Vercel env var, nunca en el cliente ni en el repo).
SUPABASE_SERVICE_ROLE_KEY=

# === Sitio ===
NEXT_PUBLIC_SITE_URL=https://motoplustalar.com.ar

# === Mercado Pago (dejar vacío hasta tener credenciales reales) ===
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# === Google ===
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GOOGLE_PLACE_ID=

# === Seguridad ===
# Secreto para firmar/verificar tareas internas (cron de ofertas vencidas, etc.)
CRON_SECRET=
